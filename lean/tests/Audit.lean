  let mut state : CollectAxioms.State := {}
  for result in results do
    -- Check that each root exists, then share the visited dependency graph.
    let _ ← getConstInfo result
    let (_, next) := ((CollectAxioms.collect result).run env).run state
    state := next
    for ax in state.axioms do
      unless allowed.contains ax do
        throwError "{result} depends on unexpected axiom {ax}"
    logInfo m!"Checked {result}"
  logInfo m!"Dependency union uses {state.axioms}"
  logInfo m!"Axiom audit passed for {results.size} public results."
